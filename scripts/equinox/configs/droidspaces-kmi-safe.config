# DroidSpaces support profile for mondrian GKI 5.10 Image-only kernels.
#
# Keep this fragment intentionally minimal. The base Equinox GKI config already
# provides the networking, cgroup, overlayfs, seccomp and namespace framework
# used by DroidSpaces. For a standalone Image that must load the ROM's existing
# vendor modules, only force the GKI options DroidSpaces documents as required.
#
# CONFIG_SYSVIPC and CONFIG_POSIX_MQUEUE are ABI-sensitive on GKI 5.10. Their
# mandatory Android KABI relocations are applied by integrate-droidspaces.sh
# before this fragment is merged.

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Do not force optional DroidSpaces features in the standalone KMI-gated
# profile. In particular USER_NS, CGROUP_PIDS and additional netfilter/ipset
# features can be enabled later only after the strict Module.symvers gate proves
# they preserve mondrian's existing vendor-module KMI. A ROM-source build can
# use a broader profile when kernel and external vendor modules are rebuilt
# together.
