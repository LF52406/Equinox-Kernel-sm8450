# Kernel branding
CONFIG_LOCALVERSION="-Equinox"
# CONFIG_LOCALVERSION_AUTO is not set

# Power
CONFIG_BQ_FG_UPDATE=y
CONFIG_MI_CHARGER_M81=y
CONFIG_MI_THERMAL_MULTI_CHARGE=y
CONFIG_WIRELESS_REVERSE_CLOSE=y

# EROFS
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
